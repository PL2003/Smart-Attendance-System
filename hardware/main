bool attendanceMode = false;
int teacherID = 121; // Fixed teacher ID range start

// Function to get student name by ID
String getStudentName(int id) {
  DynamicJsonDocument doc(8192); // Increased size for larger dataset
  DeserializationError error = deserializeJson(doc, studentDatabase);
  
  if (error) {
    Serial.println("Failed to parse student database JSON");
    return "Unknown Student";
  }
  
  String idStr = String(id);
  if (doc.containsKey(idStr)) {
    return doc[idStr].as<String>();
  }
  
  return "Unknown Student";
}

unsigned long getTime() {
  time_t now;
  struct tm timeinfo;
  if (!getLocalTime(&timeinfo, 2000)) {
    Serial.println("Failed to obtain time");
    return 0;
  }
  time(&now);
  return now;
}

String getFormattedTime() {
  struct tm timeinfo;
  if (!getLocalTime(&timeinfo)) {
    return "Time Error";
  }
  char timeString[20];
  strftime(timeString, sizeof(timeString), "%H:%M:%S", &timeinfo);
  return String(timeString);
}

void setup() {
  Serial.begin(115200);
  mySerial.begin(57600, SERIAL_8N1, 16, 17);
  
  // Initialize LCD
  lcd.init();
  lcd.backlight();
  updatelcd("LCD Initialized");
  Serial.println("LCD Initialized");
  delay(1000);

  // Connect to WiFi
  updatelcd("Welcome!", "Connecting to", "WiFi", "Please wait..");
  WiFi.begin(ssid, password);
  
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  
  Serial.println();
  Serial.println("WiFi Connected");
  Serial.print("IP address: ");
  Serial.println(WiFi.localIP());
  
  updatelcd("WiFi Connected", "Setting up time", "Please wait..", "");
  
  // Configure time
  configTime(gmtOffset_sec, daylightOffset_sec, ntpServer);
  delay(3000); // Increased wait time for time sync
  
  // Initialize fingerprint sensor
  updatelcd("WiFi Connected", "Sensor Status", "Checking...", "Please wait..");
  
  // Add this after WiFi connection in setup()
GSheet.printf("ESP Google Sheet Client v%s\n\n", ESP_GOOGLE_SHEET_CLIENT_VERSION);

// Set the callback for Google API access token
GSheet.setTokenCallback(tokenStatusCallback);

// Set the seconds to refresh the auth token before expire (60 to 3540, default is 300 seconds)
GSheet.setPrerefreshSeconds(10 * 60);

// Begin the access token generation for Google API authentication
GSheet.begin(CLIENT_EMAIL, PROJECT_ID, PRIVATE_KEY);

  finger.begin(57600);
  delay(1000); // Give sensor time to initialize
  
  if (finger.verifyPassword()) {
    Serial.println("Fingerprint sensor found!");
    updatelcd("Fingerprint Sensor", "Ready", "", "");
  } else {
    Serial.println("Fingerprint sensor NOT found!");
    updatelcd("FP Sensor ERROR!", "Check wiring.", "", "");
    while (1); // Stop execution if sensor not found
  }

  finger.getTemplateCount();
  Serial.print("Sensor contains "); 
  Serial.print(finger.templateCount); 
  Serial.println(" templates");
  
  updatelcd("WiFi Connected", "Sensor Ready", "Waiting for ID", "Place Finger");
  delay(2000);
  
  // Test student database
  Serial.println("Testing student database...");
  Serial.println("Student ID 1: " + getStudentName(1));
  Serial.println("Student ID 50: " + getStudentName(50));
}

void loop() {
  // Check WiFi connection
  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("WiFi disconnected! Reconnecting...");
    WiFi.reconnect();
    delay(5000);
    return;
  }
  
  if (!attendanceMode) {
    // Update LCD less frequently when not in use
    static unsigned long lastLCDUpdate = 0;
    if (millis() - lastLCDUpdate > 1000) { // Update every 1 second
      updatelcd("Mode OFF", "Place finger", "to turn ON", "Time: " + getFormattedTime());
      lastLCDUpdate = millis();
    }
    
    int id = getFingerprintID();
    if (id >= 121 && id <= 127) { // Teacher ID range
      attendanceMode = true;
      int index = id - 121;
      if (index >= 0 && index < 7) {
        updatelcd("Mode ON by", String(name_sir[index]) + " Sir", "Place Finger", "to give attendance");
        delay(2000);
        updatelcd( "Place Finger", "to give attendance","","");
      } else {
        updatelcd("Mode ON by", "Teacher", "Place Finger", "to give attendance");
      }
      teacherID = id; // Remember which teacher activated the mode
      delay(2000);
    }
  } else {
    // In attendance mode, poll more frequently
    int id = getFingerprintID();
    if (id == teacherID) {
      attendanceMode = false;
      updatelcd("Attendance Closed", "by  " + String(name_sir[teacherID-121]) , " Sir",  "");
      delay(2000);
      return;
    }

    // Process student attendance
    if (id > 0 && id <= 120) { // Student ID range
      String studentName = getStudentName(id);
      updatelcd("Attendance marked", "ID: " + String(id), studentName, "Processing...");
      String response = sendAttendanceToSheet(id);
      
      updatelcd("Attendance Sent", "ID: " + String(id), studentName, "Resp: " + response);
      delay(2000); // Show result for 3 seconds
      updatelcd("Pass the device","to Next!","Place Finger", "to give attendance");
    }
  }
  
  // Reduced delay for faster sensor response
  delay(50);
}

int getFingerprintID() {
  uint8_t p = finger.getImage();
  if (p == FINGERPRINT_NOFINGER) {
    return -1; // No finger detected - this is normal
  }
  if (p != FINGERPRINT_OK) {
    Serial.print("Image capture failed: ");
    Serial.println(p);
    return -1;
  }

  p = finger.image2Tz();
  if (p != FINGERPRINT_OK) {
    Serial.print("Image conversion failed: ");
    Serial.println(p);
    return -1;
  }

  p = finger.fingerFastSearch();
  if (p == FINGERPRINT_NOTFOUND) {
    Serial.println("No match found");
    return -1;
  }
  if (p != FINGERPRINT_OK) {
    Serial.print("Search failed: ");
    Serial.println(p);
    return -1;
  }

  // Found a match
  // 
  // delay(1000);
  Serial.print("Found ID #"); 
  Serial.print(finger.fingerID);
  Serial.print(" with confidence of "); 
  Serial.println(finger.confidence);
  if(finger.fingerID<120 && finger.fingerID >0){
  updatelcd("Fingerprint matched!", "ID: " + String(finger.fingerID), "Name: " + String(getStudentName(finger.fingerID)), "");}
  else{
    delay(100);
  }
  return finger.fingerID;
}
// Replace your sendAttendanceToSheet function
String sendAttendanceToSheet(int id) {
    if (!GSheet.ready()) {
        return "GSheet not ready";
    }
    
    String studentName = getStudentName(id);
    
    // Get current time
    struct tm timeinfo;
    if (!getLocalTime(&timeinfo)) {
        return "Time Error";
    }
    
    char dateStr[12];
    char timeStr[10];
    char dateTimeStr[25];
    
    strftime(dateStr, sizeof(dateStr), "%Y-%m-%d", &timeinfo);
    strftime(timeStr, sizeof(timeStr), "%H:%M:%S", &timeinfo);
    strftime(dateTimeStr, sizeof(dateTimeStr), "%d/%m/%Y %H:%M:%S", &timeinfo);
    
    FirebaseJson response;
    FirebaseJson valueRange;
    
    // Set up the data according to your sheet layout: DateTime | Student_ID | Student_Name | Date | Time
    valueRange.add("majorDimension", "ROWS");
    valueRange.set("values/[0]/[0]", String(dateTimeStr));  // DateTime column (DD/MM/YYYY HH:MM:SS)
    valueRange.set("values/[0]/[1]", id);                   // Student_ID column
    valueRange.set("values/[0]/[2]", studentName);          // Student_Name column
    valueRange.set("values/[0]/[3]", String(dateStr));      // Date column (YYYY-MM-DD)
    valueRange.set("values/[0]/[4]", String(timeStr));      // Time column (HH:MM:SS)
    
    Serial.println("Sending attendance to Google Sheet...");
    Serial.println("ID: " + String(id) + ", Name: " + studentName);
    
    // Append values to the spreadsheet
    bool success = GSheet.values.append(&response, spreadsheetId, "Sheet1!A:E", &valueRange);
    
    if (success) {
        Serial.println("✓ Attendance logged successfully");
        valueRange.clear();
        return "Success";
    } else {
        Serial.println("✗ Failed to log attendance");
        Serial.println("Error: " + GSheet.errorReason());
        return "Error: " + GSheet.errorReason();
    }
}

// Function to update LCD with up to 4 lines of text
void updatelcd(const String &line1, const String &line2, const String &line3, const String &line4) {
  lcd.clear();
  
  lcd.setCursor(0, 0);
  lcd.print(line1.substring(0, 20)); // Limit to 20 characters per line
  
  if (line2.length() > 0) {
    lcd.setCursor(0, 1);
    lcd.print(line2.substring(0, 20));
  }
  
  if (line3.length() > 0) {
    lcd.setCursor(0, 2);
    lcd.print(line3.substring(0, 20));
  }
  
  if (line4.length() > 0) {
    lcd.setCursor(0, 3);
    lcd.print(line4.substring(0, 20));
  }
}
